# ============================================================
# College Food Shop - Server environment
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB connection string) ---
# Local: mongodb://127.0.0.1:27017/food-shop
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/food-shop
DATABASE_URL=mongodb://127.0.0.1:27017/food-shop

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma separated list of domains allowed to self-register as students. Empty = open registration.
ALLOWED_EMAIL_DOMAINS=student.college.edu,example.edu
# Set to false to allow any email (local development convenience)
REQUIRE_DOMAIN_CHECK=false

# --- Payment ---
# Provider: mock | razorpay | phonepe | paytm | merchant-upi
PAYMENT_PROVIDER=razorpay

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=rzp_test_TTYAXG7VWTlIRe
RAZORPAY_KEY_SECRET=yB1ESmQed76ooaTxvS9ZLagA
VITE_RAZORPAY_KEY_ID=rzp_test_TTYAXG7VWTlIRe

# Paytm
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_ENV=STAGING
PAYTM_UPI_ID=
PAYTM_MERCHANT_NAME=

# PhonePe
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=STAGING

WEBHOOK_SECRET=change-me-webhook-secret

# --- Shop defaults ---
SHOP_NAME=College Food Shop
COLLEGE_NAME=My College
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# --- Misc ---
COOKIE_SECURE=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# --- MSG91 SMS OTP Configuration ---
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_OTP_EXPIRY=300
MSG91_OTP_RESEND_COOLDOWN=60

# --- Gmail SMTP Nodemailer Configuration ---
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
OTP_EXPIRY=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5


