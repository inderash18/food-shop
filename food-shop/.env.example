# ============================================================
# College Food Shop - Server environment
# Copy to .env and fill in values. NEVER commit .env.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database (MongoDB connection string) ---
# Local: mongodb://127.0.0.1:27017/food-shop
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/food-shop
DATABASE_URL=mongodb://127.0.0.1:27017/food-shop

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma separated list of domains allowed to self-register as students. Empty = open registration.
ALLOWED_EMAIL_DOMAINS=student.college.edu,example.edu
# Set to false to allow any email (local development convenience)
REQUIRE_DOMAIN_CHECK=false

# --- Payment ---
# Provider: mock | razorpay | paytm
PAYMENT_PROVIDER=paytm
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=DEFAULT
PAYTM_ENV=STAGING
PAYTM_UPI_ID=
PAYTM_MERCHANT_NAME=
WEBHOOK_SECRET=change-me-webhook-secret

# --- Shop defaults ---
SHOP_NAME=College Food Shop
COLLEGE_NAME=My College
CURRENCY=INR
TIMEZONE=Asia/Kolkata

# --- Misc ---
COOKIE_SECURE=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=60000
